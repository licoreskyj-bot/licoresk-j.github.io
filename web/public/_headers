# Cloudflare (Workers static assets). El service worker y el manifiesto nunca se guardan en caché
# del navegador: así cada despliegue llega en la siguiente visita. /assets/* lleva huella: inmutable.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fuentes/*
  Cache-Control: public, max-age=2592000
