{
  // LICORES K&J — la tienda se sirve como archivos estáticos desde Cloudflare Workers (gratis).
  // GitHub Pages NO sirve: sus términos prohíben alojar tiendas en línea (docs/40 §2 del cerebro).
  // Desplegar: `npm run build` y luego `npx wrangler deploy` (requiere la cuenta de Cloudflare de K&J).
  "name": "licores-kyj",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
